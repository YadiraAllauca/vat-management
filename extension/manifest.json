{
  "manifest_version": 3,
  "name": "Lila · Gastos desde el correo",
  "version": "0.1.0",
  "description": "Lee tus facturas de Gmail con un modelo de Anthropic, con tu propia key, y las envía a Lila.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://mail.google.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Lila · Buscar facturas en esta bandeja" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "src/clave.js",
        "src/parse.js",
        "src/ai.js",
        "src/gmail-dom.js",
        "src/panel.js",
        "src/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
